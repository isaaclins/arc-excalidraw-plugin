{
  "name": "arc-excalidraw-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "A tiny Arc/Chromium extension for drawing over pages with Excalidraw and saving screenshots.",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaaclins/arc-excalidraw-plugin.git"
  },
  "keywords": [
    "arc-browser",
    "browser-extension",
    "excalidraw",
    "screenshot"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/isaaclins/arc-excalidraw-plugin/issues"
  },
  "homepage": "https://github.com/isaaclins/arc-excalidraw-plugin#readme",
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.1.37",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.4",
    "typescript": "5.9.3",
    "vite": "7.2.4"
  }
}
